rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Hardcoded bootstrap admins — kept as a lockout-safety fallback so the
    // app can always be re-administered even if the staff collection is wiped.
    function isHardcodedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "fromdotacademy@gmail.com" ||
        request.auth.token.email == "tubejaf@gmail.com"
      );
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    function hasStaffDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function isAdmin() {
      return isHardcodedAdmin() ||
        (hasStaffDoc() && staffDoc().role == 'admin' && staffDoc().active == true);
    }
    function isPhlebotomist() {
      return hasStaffDoc() && staffDoc().role == 'phlebotomist' && staffDoc().active == true;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId']) && data.userId == request.auth.uid;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['bookingId', 'userId', 'patientName', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.status in ['Created', 'Assigned', 'Collected', 'Processing', 'Completed'];
    }

    // Status transitions a phlebotomist is allowed to perform.
    // Final Processing→Completed step is reserved for admins.
    function phlebStatusOK() {
      return (existing().status == 'Created' && incoming().status == 'Assigned') ||
             (existing().status == 'Assigned' && incoming().status == 'Collected') ||
             (existing().status == 'Collected' && incoming().status == 'Processing') ||
             (existing().status == incoming().status);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'language', 'phoneNumber', 'lastActive']) && isValidUser(incoming())) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role']))
      );

      match /patients/{patientId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Collection-group rule for patients. Required for queries like
    // `collectionGroup(db, 'patients')` which the admin dashboard uses to list
    // every user's saved patient profiles across all parents. The doc-level
    // rule above is still authoritative for path-bound reads/writes; this rule
    // is read-only and only widens the scope to enable group queries.
    match /{path=**}/patients/{patientId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /bookings/{bookingId} {
      // Read: admin (any), owner (own bookings), phlebotomist (assigned to them OR
      // unclaimed queue of Created bookings to enable self-assignment).
      allow list, get: if isAdmin() ||
                          (isSignedIn() && resource.data.userId == request.auth.uid) ||
                          (isPhlebotomist() && resource.data.assignedTo == request.auth.uid) ||
                          (isPhlebotomist() && resource.data.status == 'Created');

      allow create: if isSignedIn() && isValidBooking(incoming());

      allow update: if (
        // Owner: edit details only while still 'Created'.
        (isSignedIn() && existing().userId == request.auth.uid &&
         existing().status == 'Created' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['patientName', 'patientAge', 'patientGender', 'patientAddress', 'patientPhone', 'testNames', 'timeSlot', 'bookingDate', 'slotStart', 'slotEnd', 'isFastingConfirmed', 'price']) &&
         isValidBooking(incoming()))
      ) || (
        // Admin: status, price, assignedTo (incl. reassignment), priority, and
        // date/slot rescheduling.
        isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'price', 'assignedTo', 'assignedToName', 'priority', 'testNames', 'notes', 'bookingDate', 'slotStart', 'slotEnd', 'timeSlot'])
      ) || (
        // Phlebotomist: self-assign an unclaimed 'Created' booking.
        isPhlebotomist() &&
        existing().status == 'Created' &&
        incoming().status == 'Assigned' &&
        incoming().assignedTo == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedTo', 'assignedToName'])
      ) || (
        // Phlebotomist: progress own assigned booking through allowed transitions
        // and edit tests/price/notes during the home visit.
        isPhlebotomist() &&
        existing().assignedTo == request.auth.uid &&
        incoming().assignedTo == request.auth.uid &&
        phlebStatusOK() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['testNames', 'price', 'status', 'notes'])
      );
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /staff/{uid} {
      // Staff members can read their own record (so the app can detect their role).
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Booking configuration (slot template, max advance days). Singleton at
    // config/booking. Readable by any signed-in user so the bot session and the
    // in-dashboard simulator can render the slot picker. Admin-only writes.
    match /config/{document} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if isAdmin();
    }

    // Per-phlebotomist per-date availability overrides. Doc id is
    // {YYYY-MM-DD}_{phlebUid}. Default schedule lives on staff/{uid}; this
    // collection only stores deviations.
    match /phlebAvailability/{document} {
      allow get, list: if isAdmin() || isPhlebotomist();
      allow create, update, delete: if isAdmin();
    }
  }
}
