# WhatsApp Business API Credentials
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
VERIFY_TOKEN=caremol_verify_token

# Maps
VITE_GOOGLE_MAPS_API_KEY=

# DeepSeek (AI parser for patient details). No free tier — top up at platform.deepseek.com.
DEEPSEEK_API_KEY=

# CareMol contact phone (international format, no '+', e.g. 919876543210)
# Used by both the WhatsApp bot ("Call CareMol" + "Talk to Support" links)
# and the in-dashboard simulator. The VITE_-prefixed copy is required for
# the browser bundle.
CAREMOL_PHONE=
VITE_CAREMOL_PHONE=

# OPTIONAL: Firebase Admin Service Account (JSON string)
# Only needed if you are using a database in a DIFFERENT project.
# Otherwise, it will use the automatic Cloud Identity.
FIREBASE_SERVICE_ACCOUNT=
